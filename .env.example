# ────────────────────────────────────────────────────────────────────────────
# Portfolio '26 — environment variables.
#
# Copy this file to `.env.local` (gitignored) and fill in real values for
# local dev. On Vercel, set the same keys under Project Settings →
# Environment Variables. Never commit real secrets.
# ────────────────────────────────────────────────────────────────────────────

# Public site URL — used by sitemap.ts, robots.ts, and metadataBase in
# app/layout.tsx. No trailing slash. Apex preferred over www.
NEXT_PUBLIC_SITE_URL=https://nstamour.xyz

# ── Keystatic admin (/keystatic) ────────────────────────────────────────────
# Pick ONE storage strategy. Local for development; GitHub for production
# so edits go straight into pull requests on the live repo.

# Local-only (default in dev): writes to the working copy on disk.
# Comment out the GitHub block below and leave these unset.

# GitHub storage (production):
# - Create a GitHub App from the Keystatic UI:
#     https://keystatic.com/docs/github-setup
#   Install it on the portfolio repo only.
# - Copy the credentials it gives you here.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# Long random string (32+ chars). Generate with:
#   openssl rand -base64 32

# ── Admin security middleware ───────────────────────────────────────────────
# All optional — defaults are safe.

# Kill switch: set to "false" to 404 the admin without redeploying.
# ADMIN_ENABLED=true

# Optional IP allowlist. Comma-separated IPv4/IPv6. Empty/unset = allow all.
# ADMIN_ALLOWED_IPS=1.2.3.4,5.6.7.8

# Per-IP rate limit on /keystatic and /api/keystatic (defaults shown).
# ADMIN_RATELIMIT_MAX=30
# ADMIN_RATELIMIT_WINDOW_MS=60000
