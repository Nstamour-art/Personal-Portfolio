{
  "name": "portfolio-26",
  "version": "0.1.0",
  "private": true,
  "description": "N. St-Amour — Folio '26. Production portfolio site.",
  "scripts": {
    "content": "node scripts/generate-content.mjs",
    "content:watch": "chokidar \"data/**/*.{json,mdoc}\" --ignore \"data/_generated/**\" --initial -c \"node scripts/generate-content.mjs\"",
    "prebuild": "node scripts/generate-content.mjs",
    "dev": "concurrently --kill-others --raw --names content,next \"pnpm content:watch\" \"next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md}\""
  },
  "dependencies": {
    "@keystatic/core": "^0.5.50",
    "@keystatic/next": "^5.0.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.23.7",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.2.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
